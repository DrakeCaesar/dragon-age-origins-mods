# ---------------------------------------------------------------- build output
# Everything here is regenerable from src\ + ui\movies\*\patches\ (+ the game install).
build/stage/
build/*.dazip
build/dist/
src/*.ncs
ui/levelup.swf
ui/levelup_ten.swf
ui/levelup_ftg.swf
ui/levelup_ftg_ten.swf
ui/portraits.swf
ui/itemupgrade.swf

# ------------------------------------------------- third-party, NOT ours
# BioWare: extracted game resources and decompiled ActionScript.
# These are read as build inputs but must never be redistributed.
ui/movies/*/vanilla.swf
ui/movies/levelup/_base_guiexport/
ui/vanilla_scripts/
ref/script.ldf
ref/cscript.ldf
ref/levelup_*.swf
ref/ui/

# ------------------------------------------------------- local scratch trees
# _base is the pinned pristine export our patches are diffed against and
# applied to (FFDec's export is not deterministic, so it must be pinned).
# Regenerate with: powershell -File ui\make-patches.ps1 -Movie <name> -Refresh
ui/movies/*/_base/
ui/movies/*/_work/
ui/movies/*/_build/
ui/_export_check/
ui/_pristine/
ui/_verify/
ui/_import/

__pycache__/

# ------------------------------------------------ reference checkout, not ours
# Lyall's DAFix (MIT) cloned here for reference only; never part of this addin.
DAFix/

# ------------------------------------------------ session scratch
# Investigation logs, extracted tables and throwaway scripts used while chasing
# how enemy level scaling works; nothing here is an input to the build.
_work/
