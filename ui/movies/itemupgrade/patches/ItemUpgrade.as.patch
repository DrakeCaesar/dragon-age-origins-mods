+   static function RefreshAfterRuneChange()
+   {
+      // The message that moved the rune is queued, so re-reading on the next
+      // tick describes the backpack as it is after the rune landed rather than
+      // as it was before. The token observer would do this too, but it is not
+      // delivered reliably enough to rely on for the pane's own actions.
+      FuncUtils.CallWithDelay(function()
+      {
+         var sSelectedToken = null;
+         var sSelectedTag = "";
+         if(ItemUpgrade.mcSelectedItem)
+         {
+            sSelectedToken = ItemUpgrade.mcSelectedItem.TokenName;
+            sSelectedTag = String(ItemUpgrade.mcSelectedItem.Tag);
+         }
+         RuneList.InvalidateCache();
+         if(ItemUpgrade.mcItemList)
+         {
+            ItemUpgrade.mcItemList.GenerateList();
+         }
+         if(!ItemUpgrade.ReselectItem(sSelectedToken,sSelectedTag))
+         {
+            if(ItemUpgrade.mcRuneList)
+            {
+               ItemUpgrade.mcRuneList.GenerateList();
+            }
+            ItemUpgrade.UpdateUpgradePane();
+         }
+         ItemUpgrade.RefreshSelectedItemTooltip();
+      }
+      ,0);
+   }
+   static function ReselectItem(a_sToken, a_sTag)
+   {
+      // A rune makes an item unique, so it leaves its group of duplicates when
+      // one is attached: keep editing that item instead of whatever row slid
+      // into its place. Returns false when the selection did not move, so the
+      // caller knows it still has to refresh the pane itself.
+      if(mcItemList == null)
+      {
+         return false;
+      }
+      var mcMatch = mcItemList.FindEntry(a_sToken,a_sTag);
+      if(mcMatch == null || mcMatch == mcSelectedItem)
+      {
+         return false;
+      }
+      mcMatch.Select();
+      return true;
+   }
+   static function RefreshSelectedItemTooltip()
+   {
+      // Only the tooltip of the item being edited can have changed, and only if
+      // it is the one on screen; any other entry rebuilds its own on the next
+      // rollover.
+      if(mcSelectedItem && mcSelectedItem.SetupItemTooltip && MovieUtils.IsMouseWithinMovie(mcSelectedItem))
+      {
+         mcSelectedItem.SetupItemTooltip();
       }
    }
